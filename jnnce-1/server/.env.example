# Copy this file to `.env` and fill in your key. `.env` is gitignored.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_MAX_TOKENS=400
# GEMINI_TEMPERATURE=0.3
# PORT=3000

# Per-IP rate limit on /api/ai. Each call can upload two screenshots and spends
# upstream quota, so this guards cost rather than CPU.
# AI_RATE_MAX=10
# AI_RATE_WINDOW_MS=60000

# Multiplayer. Clients are separated by room id, so a passphrase is only needed
# if you do not want strangers joining a room whose id they guessed or were sent.
# Leave unset for local development. Set it before exposing the port.
# MULTIPLAYER_PASSPHRASE=

# Ceiling on inbound state updates per socket. The client emits at 20Hz.
# STATE_RATE_MAX=40
# STATE_RATE_WINDOW_MS=1000
